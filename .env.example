# Xiaomi MiMo 模型配置
# 注意：不要将真实 API Key 提交到仓库
MIMO_API_KEY=
# Token Plan 专属 Base URL（默认）
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
# 按量付费 Base URL：https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-pro
# 快速模型（分类/规划/分析等迭代节点使用）
MIMO_FAST_MODEL=mimo-v2.6-flash
MIMO_TIMEOUT=60

# Agent 执行限制（Phase 2 起生效）
AGENT_MAX_STEPS=3
AGENT_TIMEOUT=120

# 网络诊断安全限制
# ⚠️ 当前默认 DIAG_ALLOW_ALL_TARGETS=true，允许对任意 IP 执行诊断。
#    仅在受控测试环境中使用；请勿对未授权网络、主机或设备执行扫描。
#    如需恢复白名单防护，改为 false 并配置 DIAG_ALLOWED_TARGETS。
DIAG_ALLOW_ALL_TARGETS=false
# 目标白名单（逗号分隔），仅在 DIAG_ALLOW_ALL_TARGETS=false 时生效
DIAG_ALLOWED_TARGETS=localhost,127.0.0.1,::1
DIAG_TIMEOUT=10

# RAG 知识库配置（Phase 3 起生效）
RAG_KB_DIR=data/knowledge_base
RAG_PERSIST_DIR=data/chroma_db
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# 诊断记录存储（Phase 4 起生效）
STORAGE_DB_PATH=data/netops.db
